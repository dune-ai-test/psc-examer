<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Padanam" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cloud</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/indigo</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Padanam.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cloud</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/navy</item>
        <item name="postSplashScreenTheme">@style/Theme.Padanam</item>
    </style>

</resources>
